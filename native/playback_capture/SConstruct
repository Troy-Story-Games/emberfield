#!/usr/bin/env python
env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")
if env["platform"] == "windows":
    env.Append(LIBS=["ole32", "uuid"])

library = env.SharedLibrary(
    "bin/libplayback_capture{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
Default(library)
